# Copy to app/.env and fill in ONE of these to get real 3D in the drop picker.
# With none set, the 3D view uses free satellite imagery on a flat globe.
#
# Priority: custom tileset > Google > Cesium ion.

# Your own 3D Tiles (tileset.json URL), e.g. a purchased Vantor 3DSM or a WebODM model of the demo field.
VITE_CUSTOM_3DTILES_URL=

# Google Photorealistic 3D Tiles (Google Maps Platform, "Map Tiles API" enabled).
# This key is visible to browsers, so restrict it to your site's HTTP referrers in the Google console.
VITE_GOOGLE_MAPS_API_KEY=

# Free Cesium ion account (cesium.com/ion): Cesium World Terrain + OSM Buildings.
VITE_CESIUM_ION_TOKEN=
